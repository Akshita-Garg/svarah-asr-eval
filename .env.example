# Copy this file to `.env` and fill in the values. `.env` is gitignored and is
# NEVER written to any result artifact.

# --- Required to load the gated Svarah dataset ------------------------------
# 1. Log in to HuggingFace and accept the terms at:
#      https://huggingface.co/datasets/ai4bharat/Svarah
# 2. Create a token at HuggingFace -> Settings -> Access Tokens (read scope).
HF_TOKEN=

# --- Required for the ElevenLabs cloud backend ------------------------------
# From the ElevenLabs dashboard. Omit to skip that backend (it degrades cleanly).
ELEVENLABS_API_KEY=

# --- Required for the optional Sarvam cloud backend -------------------------
SARVAM_API_KEY=

# --- Required for the optional Smallest.ai Pulse Pro backend ----------------
# The harness also accepts the legacy/local spelling SMALLESTAI_API_KEY.
SMALLEST_API_KEY=

# --- Optional: override local artifact locations ----------------------------
# Defaults point at the sibling VoiceRefine Desktop project; set these only if
# your models/binary live elsewhere. (Same variables the desktop app honors.)
# VOICEREFINE_SHERPA_MODEL_DIR=
# VOICEREFINE_SHERPA_THREADS=4
# VOICEREFINE_CRISPASR_BIN=
# VOICEREFINE_CRISPASR_PARAKEET_MODEL=
# VOICEREFINE_CRISPASR_COHERE_MODEL=
# VOICEREFINE_CRISPASR_WHISPER_MODEL=
# VOICEREFINE_CRISPASR_PORT=51234
# VOICEREFINE_CRISPASR_THREADS=8
# VOICEREFINE_CRISPASR_GPU_BACKEND=cpu

# --- Optional: silence a Windows huggingface_hub symlink warning ------------
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
